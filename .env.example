# Backend selection: auto | local | openai | fake
# auto -> OpenAI when OPENAI_API_KEY is set, otherwise local
# fake -> deterministic offline backend, for smoke tests only
EMBEDDING_BACKEND=auto
LLM_BACKEND=auto

# OpenAI (used when backend=openai, or auto + key present)
# OPENAI_API_KEY=replace-with-your-key
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Local models (free, run on CPU). Lighter alternative: HuggingFaceTB/SmolLM2-135M-Instruct
LOCAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_CHAT_MODEL=HuggingFaceTB/SmolLM2-360M-Instruct

# RAG tuning
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4

# PostgreSQL/pgvector for Compose (use a strong password before deployment).
# If running a CLI on the host, change "pgvector" in PGVECTOR_URL to "localhost".
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me-before-use
POSTGRES_DB=ragdb
PGVECTOR_URL=postgresql+psycopg://rag:change-me-before-use@pgvector:5432/ragdb

# Pinecone (managed cloud store)
# PINECONE_API_KEY=replace-with-your-key
PINECONE_INDEX=rag-kb

# Shared collection name (chroma / pgvector)
COLLECTION_NAME=rag_kb
